{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "audio:analyze": "bun scripts/analyze-redesign-audio.ts",
    "build": "next build",
    "check": "bun run fmt && bun run lint && bun run typecheck",
    "dev": "next dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "gen:icons": "svgr --out-dir src/components/icons --typescript --icon --replace-attr-values \"#000=currentColor\" public/svg-icons",
    "lint": "oxlint . --report-unused-disable-directives-severity warn",
    "lint:fix": "oxlint . --fix --report-unused-disable-directives-severity warn",
    "prepare": "husky",
    "start": "next start",
    "supabase:env": "bun ./scripts/supabase-env.ts",
    "supabase:setup": "bunx supabase start && bun run supabase:env",
    "supabase:types": "bunx supabase gen types --local --schema public > src/types/supabase.ts",
    "test": "bun test",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit"
  },
  "dependencies": {
    "@blocknote/core": "0.54.2",
    "@blocknote/mantine": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@blocknote/server-util": "0.54.2",
    "@blocknote/xl-multi-column": "0.54.2",
    "@stylexjs/stylex": "0.19.0",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/speed-insights": "^2.0.0",
    "agentation-mcp": "1.2.0",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.23",
    "es-toolkit": "1.52.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^13.1.1",
    "ipaddr.js": "^2.5.0",
    "jose": "6.2.12",
    "jotai": "2.20.3",
    "lenis": "1.3.26",
    "lucide-react": "^1.37.0",
    "music-metadata": "^11.15.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "supabase": "2.117.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@svgr/cli": "^8.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "agentation": "3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "^9.1.7",
    "oxfmt": "0.65.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "type-fest": "5.8.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "jsdom": "26.1.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "ffmpeg-static",
    "sharp",
    "supabase",
    "unrs-resolver"
  ],
  "imports": {
    "#dictionary": {
      "react-server": "./src/lib/server/dictionary/dictionary.service.ts",
      "default": "./src/lib/client/dictionary/dictionary-provider.component.tsx"
    }
  },
  "license": "GPL-3.0-only",
  "patchedDependencies": {
    "@blocknote/server-util@0.54.2": "patches/@blocknote%2Fserver-util@0.54.2.patch"
  }
}
