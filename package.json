{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "gen:icons": "svgr --out-dir src/components/icons --typescript --icon --replace-attr-values \"#000=currentColor\" public/svg-icons",
    "gen:types:dev": "source .env.development && bunx supabase gen types typescript --project-id $(echo $NEXT_PUBLIC_SUPABASE_URL | sed 's/https:\\/\\///' | cut -d'.' -f1) > src/types/supabase.ts",
    "gen:types:prod": "source .env.production && bunx supabase gen types typescript --project-id $(echo $NEXT_PUBLIC_SUPABASE_URL | sed 's/https:\\/\\///' | cut -d'.' -f1) > src/types/supabase.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix ",
    "menu": "bun ./scripts/menu.ts",
    "start": "next start",
    "test": "bun test",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@lezer/markdown": "1.7.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/speed-insights": "^2.0.0",
    "agentation-mcp": "1.2.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "1.52.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.1.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "prism-themes": "^1.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-prism-plus": "^2.0.2",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.103.1",
    "sonner": "^2.0.8",
    "supabase": "^2.116.0",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "agentation": "3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss-scss": "^4.0.9",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "type-fest": "5.8.0",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
