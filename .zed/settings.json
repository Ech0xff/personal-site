{
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TSX": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TypeScript": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JSON": {
      "language_servers": ["json-language-server", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "JSONC": {
      "language_servers": ["json-language-server", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "CSS": {
      "language_servers": [
        "vscode-css-language-server",
        "tailwindcss-language-server",
        "oxfmt"
      ],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "SCSS": {
      "language_servers": ["vscode-css-language-server", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "HTML": {
      "language_servers": ["vscode-html-language-server", "oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "TOML": {
      "language_servers": ["oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "formatter": { "language_server": { "name": "rust-analyzer" } }
    },
    "Markdown": {
      "language_servers": ["oxfmt"],
      "formatter": { "language_server": { "name": "oxfmt" } }
    }
  },
  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    }
  }
}
